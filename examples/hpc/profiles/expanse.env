# shellcheck shell=bash disable=SC2034
# ------------------------------------------------------------------------------
# SDSC Expanse GPU (x86_64; 4x NVIDIA V100 32 GB per node).
# Source: www.sdsc.edu/systems/expanse/user_guide.html (checked 2026-09-26).
# ------------------------------------------------------------------------------
AGB_PROFILE_NAME="expanse"
AGB_SCHEDULER="slurm"
AGB_ARCH="x86_64"

# -A <project> (documented in every example).
AGB_GPU_ACCOUNT="${AGB_GPU_ACCOUNT:-}"
AGB_CPU_ACCOUNT="${AGB_CPU_ACCOUNT:-}"
AGB_ACCOUNT_REQUIRED=1

# gpu-shared: max 48 h, max 24 jobs running + queued per user (array tasks count as
# jobs), so at most 24 array tasks are submitted and each process runs several tiles
# in turn. --constraint="lustre" is REQUIRED when a job touches /expanse/lustre
# ("Jobs submitted without --constraint="lustre" that need the Lustre filesystem ...
# will FAIL"); keep it if the manifest, caches or outputs live there.
# --cpus-per-task=10 is an agribound choice.
AGB_GPU_SBATCH="--partition=gpu-shared --gpus=1 --cpus-per-task=10 --constraint=lustre"
AGB_GPU_TIME="24:00:00"
AGB_GPU_MAX_CONCURRENT=24
AGB_GPUS_PER_TASK=1
AGB_MAX_ARRAY_TASKS=24
# Per-user limits on running + queued jobs (partition table, re-checked 2026-09-27),
# checked by submit_region.sh before it submits anything.
AGB_GPU_MAX_SUBMIT=24

# CPU 'shared': max 48 h, 4096 jobs running + queued. Documented example:
# -p shared --nodes=1 --ntasks-per-node=8 -A <project>. The --mem value is an
# agribound choice.
AGB_CPU_SBATCH="--partition=shared --nodes=1 --ntasks-per-node=4 --mem=16G --constraint=lustre"
AGB_CPU_TIME="04:00:00"
AGB_CPU_PAR=1
AGB_MAX_ARRAY_TASKS_CPU=0
AGB_CPU_MAX_SUBMIT=4096
AGB_MERGE_SBATCH="--partition=shared --nodes=1 --ntasks-per-node=16 --mem=64G --constraint=lustre"
AGB_MERGE_TIME="04:00:00"
AGB_MAX_ARRAY_SIZE=1000

# Research notes: GPU jobs load "module purge; module load gpu slurm" for site CUDA
# stacks; not needed for a self-contained conda env.
AGB_GPU_MODULES=""
AGB_CPU_MODULES=""
# V100 (Volta) needs a CUDA 12.x torch build; CUDA 13 wheels dropped Volta.
AGB_TORCH_INDEX_URL="https://download.pytorch.org/whl/cu126"
