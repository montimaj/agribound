# shellcheck shell=bash disable=SC2034
# ------------------------------------------------------------------------------
# Purdue Anvil GPU (x86_64; 16 nodes with 4x NVIDIA A100 40 GB).
# Sources: rcac-docs.s3-hosted.rcac.purdue.edu/userguides/anvil/jobs and the
# RCAC-Docs repository (jobs.md, architecture.md; checked 2026-09-26).
# ------------------------------------------------------------------------------
AGB_PROFILE_NAME="anvil"
AGB_SCHEDULER="slurm"
AGB_ARCH="x86_64"

# -A / --account is required ("your allocation account"); list accounts with
# `mybalance`. GPU queues are charged to separately exchanged GPU SUs; the naming of
# GPU accounts is UNVERIFIED -- use the name `mybalance` shows.
AGB_GPU_ACCOUNT="${AGB_GPU_ACCOUNT:-}"
AGB_CPU_ACCOUNT="${AGB_CPU_ACCOUNT:-}"
AGB_ACCOUNT_REQUIRED=1

# Queue 'gpu': max 48 h, max 12 GPUs in use per user (32 per allocation).
# --cpus-per-task=16 is an agribound choice.
AGB_GPU_SBATCH="--partition=gpu --gpus-per-node=1 --cpus-per-task=16"
AGB_GPU_TIME="12:00:00"
AGB_GPU_MAX_CONCURRENT=12
AGB_GPUS_PER_TASK=1
AGB_MAX_ARRAY_TASKS=0

# CPU queue 'shared': max 96 h, 1280 cores per user, no job-count limit. Memory is
# assigned per core on shared nodes (UNVERIFIED amount; add --mem if allowed).
AGB_CPU_SBATCH="--partition=shared --ntasks=1 --cpus-per-task=8"
AGB_CPU_TIME="04:00:00"
AGB_CPU_PAR=1
AGB_MAX_ARRAY_TASKS_CPU=0
AGB_MERGE_SBATCH="--partition=shared --ntasks=1 --cpus-per-task=32"
AGB_MERGE_TIME="04:00:00"
AGB_MAX_ARRAY_SIZE=1000
# No per-user limit on submitted jobs is documented for this system, so
# AGB_GPU_MAX_SUBMIT / AGB_CPU_MAX_SUBMIT are unset (not checked). Find yours with
# `sacctmgr show assoc user=$USER` / `sacctmgr show qos` (MaxSubmitJobs) and set them.

# The RCAC GPU job example uses: module --force purge; module load modtree/gpu
# (needed for site CUDA modules; not needed for a self-contained conda env).
AGB_GPU_MODULES=""
AGB_CPU_MODULES=""
AGB_TORCH_INDEX_URL="https://download.pytorch.org/whl/cu126"
