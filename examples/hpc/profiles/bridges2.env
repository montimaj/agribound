# shellcheck shell=bash disable=SC2034
# ------------------------------------------------------------------------------
# PSC Bridges-2 (x86_64). GPU types: v100-16, v100-32, l40s-48, h100-80 (ten 8x H100
# 80 GB nodes).
# Source: www.psc.edu/resources/bridges-2/user-guide/ (checked 2026-09-26).
# ------------------------------------------------------------------------------
AGB_PROFILE_NAME="bridges2"
AGB_SCHEDULER="slurm"
AGB_ARCH="x86_64"

# "-A <allocation id>" selects a non-default allocation (optional otherwise).
AGB_GPU_ACCOUNT="${AGB_GPU_ACCOUNT:-}"
AGB_CPU_ACCOUNT="${AGB_CPU_ACCOUNT:-}"
AGB_ACCOUNT_REQUIRED=0

# GPU-shared: part of one node, at most 4 GPUs per job; batch syntax --gpus=type:n.
# Walltime: 48 h in our research notes, 72 h in the current user-guide summary --
# check with: sinfo -p GPU-shared -o "%P %l".
AGB_GPU_SBATCH="--partition=GPU-shared --gpus=h100-80:1"
AGB_GPU_TIME="12:00:00"
# agribound choice (no per-user GPU limit found in the user guide).
AGB_GPU_MAX_CONCURRENT=8
AGB_GPUS_PER_TASK=1
AGB_MAX_ARRAY_TASKS=0

# CPU: RM-shared uses part of one node (max 64 cores per job, 72 h).
AGB_CPU_SBATCH="--partition=RM-shared --ntasks-per-node=4"
AGB_CPU_TIME="04:00:00"
AGB_CPU_PAR=1
AGB_MAX_ARRAY_TASKS_CPU=0
AGB_MERGE_SBATCH="--partition=RM-shared --ntasks-per-node=16"
AGB_MERGE_TIME="04:00:00"
AGB_MAX_ARRAY_SIZE=1000
# No per-user limit on submitted jobs is documented for this system, so
# AGB_GPU_MAX_SUBMIT / AGB_CPU_MAX_SUBMIT are unset (not checked). Find yours with
# `sacctmgr show assoc user=$USER` / `sacctmgr show qos` (MaxSubmitJobs) and set them.

AGB_GPU_MODULES=""
AGB_CPU_MODULES=""
# V100 nodes need a CUDA 12.x build of torch (CUDA 13 dropped Volta); cu126 also runs
# on L40S/H100 with a recent driver.
AGB_TORCH_INDEX_URL="https://download.pytorch.org/whl/cu126"
# Storage: /ocean/projects/<group>/<user> (project), /jet/home/<user>.
