# shellcheck shell=bash disable=SC2034
# ------------------------------------------------------------------------------
# Generic Slurm cluster -- copy this file, fill in the values from your site's
# documentation (`sinfo -s`, `sacctmgr show assoc user=$USER`, `scontrol show config`),
# and pass it with --profile /path/to/mysite.env.
# ------------------------------------------------------------------------------
AGB_PROFILE_NAME="generic"
AGB_SCHEDULER="slurm"
AGB_ARCH="x86_64"

AGB_GPU_ACCOUNT="${AGB_GPU_ACCOUNT:-}"
AGB_CPU_ACCOUNT="${AGB_CPU_ACCOUNT:-}"
# Set to 1 if your site rejects jobs without --account.
AGB_ACCOUNT_REQUIRED=0

# One GPU per array task. Sites that reject --gres/--gpus (e.g. TACC) need node-level
# requests instead; see stampede3.env.
AGB_GPU_SBATCH="--partition=gpu --gpus=1 --cpus-per-task=8 --mem=48G"
AGB_GPU_TIME="12:00:00"
AGB_GPU_MAX_CONCURRENT=8   # stay within your per-user GPU limit
AGB_GPUS_PER_TASK=1        # >1: tiles run in parallel, one per GPU of a whole node
AGB_MAX_ARRAY_TASKS=0      # >0: cap on submitted array tasks (MaxSubmitJobs)
AGB_GPU_MAX_SUBMIT=0       # >0: per-user limit on pending + running jobs in the GPU
                           # partition (sacctmgr show qos); checked before submitting

AGB_CPU_SBATCH="--partition=cpu --cpus-per-task=4 --mem=16G"
AGB_CPU_TIME="04:00:00"
AGB_CPU_PAR=1
AGB_MAX_ARRAY_TASKS_CPU=0
AGB_CPU_MAX_SUBMIT=0       # the same for the CPU partition
AGB_MERGE_SBATCH="--partition=cpu --cpus-per-task=8 --mem=64G"
AGB_MERGE_TIME="04:00:00"
AGB_MAX_ARRAY_SIZE=1000    # below the site's MaxArraySize (Slurm default 1001)

AGB_GPU_MODULES=""
AGB_CPU_MODULES=""
AGB_TORCH_INDEX_URL="https://download.pytorch.org/whl/cu126"
