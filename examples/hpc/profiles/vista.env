# shellcheck shell=bash disable=SC2034
# ------------------------------------------------------------------------------
# TACC Vista (aarch64, NVIDIA Grace). gh = Grace Hopper nodes with one GPU each;
# gg = Grace-Grace CPU nodes.
# Source: docs.tacc.utexas.edu/hpc/vista/ (Table 4, checked 2026-09-26). Vista's
# allocation path (TACC vs NAIRR) was not verified (it is not in the ACCESS
# resource list).
# ------------------------------------------------------------------------------
AGB_PROFILE_NAME="vista"
AGB_SCHEDULER="slurm"
AGB_ARCH="aarch64"

AGB_GPU_ACCOUNT="${AGB_GPU_ACCOUNT:-}"
AGB_CPU_ACCOUNT="${AGB_CPU_ACCOUNT:-}"
AGB_ACCOUNT_REQUIRED=0

# Queue gh: max 64 nodes/job, 48 h, Max Jobs per User 20, Max Submit 40 (re-checked
# 2026-09-27; array tasks count as jobs), 1 SU per node-hour. Vista REJECTS --gres and --gpus-per-task; nodes are exclusive
# and have one GPU, so one tile per task.
AGB_GPU_SBATCH="--partition=gh --nodes=1 --ntasks=1"
AGB_GPU_TIME="12:00:00"
AGB_GPU_MAX_CONCURRENT=20
AGB_GPUS_PER_TASK=1
AGB_MAX_ARRAY_TASKS=40
# Per-user limits on submitted (pending + running) jobs, checked by submit_region.sh.
AGB_GPU_MAX_SUBMIT=40

# CPU staging on gg (Grace-Grace, Max Jobs per User 20, Max Submit 40, 0.33 SU per
# node-hour).
AGB_CPU_SBATCH="--partition=gg --nodes=1 --ntasks=1"
AGB_CPU_TIME="12:00:00"
AGB_CPU_PAR=5
AGB_MAX_ARRAY_TASKS_CPU=20
AGB_CPU_MAX_SUBMIT=40
AGB_MERGE_SBATCH="--partition=gg --nodes=1 --ntasks=1"
AGB_MERGE_TIME="04:00:00"
AGB_MAX_ARRAY_SIZE=1000
# The Vista user guide: "Do not use the Slurm --export option to manage your job's
# environment" (sbatch options table: "Avoid this option"). submit_region.sh therefore
# sets the job variables in the environment of the sbatch command instead.
AGB_SBATCH_EXPORT="env"

# aarch64: use conda-forge linux-aarch64 for GDAL/rasterio; PyPI has aarch64 torch wheels.
AGB_GPU_MODULES=""
AGB_CPU_MODULES=""
AGB_TORCH_INDEX_URL="https://download.pytorch.org/whl/cu126"
