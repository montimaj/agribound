# shellcheck shell=bash disable=SC2034
# ------------------------------------------------------------------------------
# NCSA DeltaAI (aarch64; 4x NVIDIA GH200 per node, H100 96 GB HBM3, 72-core Grace).
# Sources: docs.ncsa.illinois.edu/systems/deltaai/en/latest/user-guide/
# (running-jobs.html, architecture.html, job-accounting.html; checked 2026-09-26).
# ------------------------------------------------------------------------------
AGB_PROFILE_NAME="deltaai"
AGB_SCHEDULER="slurm"
AGB_ARCH="aarch64"

# Accounts look like <code>-dtai-gh (documentation examples abcd-dtai-gh, bbkg-dtai-gh).
AGB_GPU_ACCOUNT="${AGB_GPU_ACCOUNT:-}"
AGB_CPU_ACCOUNT="${AGB_CPU_ACCOUNT:-${AGB_GPU_ACCOUNT:-}}"
AGB_ACCOUNT_REQUIRED=1

# ghx4: max 48 h (ghx4-interactive: 2 h, 1 running job). 1 GPU = 1/4 node. The
# 16 cores / 80 GB request is an agribound choice (documented examples use
# --cpus-per-task 16-72 and --mem 40g-80g).
AGB_GPU_SBATCH="--partition=ghx4 --gpus-per-node=1 --cpus-per-task=16 --mem=80g"
AGB_GPU_TIME="12:00:00"
# Per-user limits are "TBD" in the docs; agribound choice.
AGB_GPU_MAX_CONCURRENT=16
AGB_GPUS_PER_TASK=1
AGB_MAX_ARRAY_TASKS=0

# DeltaAI documents no CPU-only partition ("All nodes are in a single partition"), so
# stage jobs below also request one GPU (charged). Cheaper alternatives: stage on
# Delta's 'cpu' partition or on a Jetstream2 VM into shared storage, or use
# submit_region.sh --stage-where here where the login-node policy allows it.
AGB_CPU_SBATCH="--partition=ghx4 --gpus-per-node=1 --cpus-per-task=8 --mem=32g"
AGB_CPU_TIME="04:00:00"
AGB_CPU_PAR=1
AGB_MAX_ARRAY_TASKS_CPU=0
AGB_MERGE_SBATCH="--partition=ghx4 --gpus-per-node=1 --cpus-per-task=8 --mem=80g"
AGB_MERGE_TIME="04:00:00"
AGB_MAX_ARRAY_SIZE=1000
# No per-user limit on submitted jobs is documented for this system, so
# AGB_GPU_MAX_SUBMIT / AGB_CPU_MAX_SUBMIT are unset (not checked). Find yours with
# `sacctmgr show assoc user=$USER` / `sacctmgr show qos` (MaxSubmitJobs) and set them.

# aarch64: "many python packages may not be built for that" (DeltaAI docs). Use
# conda-forge linux-aarch64 for GDAL/rasterio, or the NGC PyTorch containers in
# /sw/user/NGC_containers/ (Apptainer --nv). Module: python/miniforge3_pytorch.
AGB_GPU_MODULES=""
AGB_CPU_MODULES=""
# PyPI hosts aarch64 torch wheels; pick the CUDA build that matches the node driver.
AGB_TORCH_INDEX_URL="https://download.pytorch.org/whl/cu126"
