# shellcheck shell=bash disable=SC2034
# ------------------------------------------------------------------------------
# NCSA Delta (x86_64; NVIDIA A100 / A40 GPU nodes).
# Sources: docs.ncsa.illinois.edu/systems/delta/en/latest/user_guide/running_jobs.html
# and architecture.html (checked 2026-09-26). Values marked "agribound choice" are
# defaults picked for agribound tiles, not site limits; "UNVERIFIED" = not found in
# the public documentation -- check on the system.
# ------------------------------------------------------------------------------
AGB_PROFILE_NAME="delta"
AGB_SCHEDULER="slurm"
AGB_ARCH="x86_64"

# Accounts: list yours with `accounts` ("Project" column). GPU allocations follow
# <code>-delta-gpu (documentation example: bbka-delta-gpu); CPU accounts are listed
# separately -- the <code>-delta-cpu pattern is UNVERIFIED.
AGB_GPU_ACCOUNT="${AGB_GPU_ACCOUNT:-}"
AGB_CPU_ACCOUNT="${AGB_CPU_ACCOUNT:-}"
AGB_ACCOUNT_REQUIRED=1

# GPU: gpuA100x4 (4x A100 40 GB per node) or gpuA40x4 (4x A40 48 GB, charge factor
# 0.5); also gpuA100x8, gpuH200x8 (max 1 node/job), *-preempt, *-interactive. Max
# 48 h; node sharing is the default. One GPU per task; 16 cores / 64 GB is an
# agribound choice (a quarter of an A100x4 node).
AGB_GPU_SBATCH="--partition=gpuA100x4 --gpus-per-node=1 --cpus-per-task=16 --mem=64g"
AGB_GPU_TIME="12:00:00"
# Per-user GPU limits are "TBD" in the Delta docs; 16 concurrent tasks is an agribound choice.
AGB_GPU_MAX_CONCURRENT=16
AGB_GPUS_PER_TASK=1
AGB_MAX_ARRAY_TASKS=0

# CPU staging / merge: partition 'cpu' (max 48 h). Documented serial example:
# --partition=cpu --mem=16g --cpus-per-task=4.
AGB_CPU_SBATCH="--partition=cpu --cpus-per-task=4 --mem=16g"
AGB_CPU_TIME="04:00:00"
AGB_CPU_PAR=1
AGB_MAX_ARRAY_TASKS_CPU=0
AGB_MERGE_SBATCH="--partition=cpu --cpus-per-task=4 --mem=64g"
AGB_MERGE_TIME="04:00:00"

# Slurm's default MaxArraySize is 1001 (check: scontrol show config | grep MaxArraySize).
# The Delta docs section on array jobs is a "Not yet implemented" placeholder, so test
# a small array first.
AGB_MAX_ARRAY_SIZE=1000
# No per-user limit on submitted jobs is documented for this system, so
# AGB_GPU_MAX_SUBMIT / AGB_CPU_MAX_SUBMIT are unset (not checked). Find yours with
# `sacctmgr show assoc user=$USER` / `sacctmgr show qos` (MaxSubmitJobs) and set them.

# Modules are optional when agribound runs from its own conda env (AGB_CONDA_ENV).
# Delta provides e.g. pytorch-conda/2.8 and Apptainer (--nv) with NGC images in
# /sw/external/NGC/.
AGB_GPU_MODULES=""
AGB_CPU_MODULES=""
# PyTorch wheel index for installing torch into the env (see README "Install").
AGB_TORCH_INDEX_URL="https://download.pytorch.org/whl/cu126"
# Storage: /projects/<code>, /work/hdd/<code>, /work/nvme. Keep envs, caches and outputs
# out of $HOME (conda defaults to $HOME/.conda).
