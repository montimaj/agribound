# shellcheck shell=bash disable=SC2034
# ------------------------------------------------------------------------------
# SDSC Expanse AI (x86_64; 34 nodes with 4x NVIDIA H100; NAIRR-allocated).
# Source: www.sdsc.edu/systems/expanse/user_guide.html (checked 2026-09-26).
# ------------------------------------------------------------------------------
AGB_PROFILE_NAME="expanse_ai"
AGB_SCHEDULER="slurm"
AGB_ARCH="x86_64"

AGB_GPU_ACCOUNT="${AGB_GPU_ACCOUNT:-}"
AGB_CPU_ACCOUNT="${AGB_CPU_ACCOUNT:-}"
AGB_ACCOUNT_REQUIRED=1

# nairr-gpu-shared: max 48 h, 16 jobs running + queued per user. Documented request:
# --gpus=h100:1. Lustre is NOT mounted on Expanse AI nodes (the guide suggests
# /scratch/$USER/job_$SLURM_JOB_ID plus Ceph S3). agribound tiles need the manifest,
# caches and outputs on a filesystem shared by login and compute nodes; which shared
# filesystem to use on Expanse AI is UNVERIFIED -- ask SDSC before large runs.
AGB_GPU_SBATCH="--partition=nairr-gpu-shared --gpus=h100:1 --cpus-per-task=16"
AGB_GPU_TIME="24:00:00"
AGB_GPU_MAX_CONCURRENT=16
AGB_GPUS_PER_TASK=1
AGB_MAX_ARRAY_TASKS=16
# Per-user limits on running + queued jobs (partition table, re-checked 2026-09-27).
AGB_GPU_MAX_SUBMIT=16

# Staging / merge on the Expanse CPU 'shared' partition (UNVERIFIED that a NAIRR
# allocation includes CPU time; replace with a CPU allocation or stage elsewhere).
AGB_CPU_SBATCH="--partition=shared --nodes=1 --ntasks-per-node=4 --mem=16G"
AGB_CPU_TIME="04:00:00"
AGB_CPU_PAR=1
AGB_MAX_ARRAY_TASKS_CPU=0
AGB_CPU_MAX_SUBMIT=4096
AGB_MERGE_SBATCH="--partition=shared --nodes=1 --ntasks-per-node=16 --mem=64G"
AGB_MERGE_TIME="04:00:00"
AGB_MAX_ARRAY_SIZE=1000

AGB_GPU_MODULES=""
AGB_CPU_MODULES=""
AGB_TORCH_INDEX_URL="https://download.pytorch.org/whl/cu126"
