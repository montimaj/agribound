# shellcheck shell=bash disable=SC2034
# ------------------------------------------------------------------------------
# TACC Stampede3 H100 nodes (x86_64; 24 nodes with 4x NVIDIA H100 96 GB).
# Source: docs.tacc.utexas.edu/hpc/stampede3/ (Table 8, checked 2026-09-26).
# ------------------------------------------------------------------------------
AGB_PROFILE_NAME="stampede3"
AGB_SCHEDULER="slurm"
AGB_ARCH="x86_64"

# -A <projectid> is "only necessary for logins associated with multiple projects".
AGB_GPU_ACCOUNT="${AGB_GPU_ACCOUNT:-}"
AGB_CPU_ACCOUNT="${AGB_CPU_ACCOUNT:-}"
AGB_ACCOUNT_REQUIRED=0

# Queue h100: max 4 nodes/job, 48 h, 4 SU per node-hour, Max Jobs per User 2, Max
# Submit 4 (Table 8, re-checked 2026-09-27; array tasks count as jobs). Nodes are exclusive and
# Stampede3 REJECTS --gres (and --gpus-per-task), so no GPU flag is given: each task
# takes a whole node and runs 4 tiles in parallel, one per GPU
# (CUDA_VISIBLE_DEVICES=0..3), and each process runs several tiles in turn so that
# at most 2 array tasks are submitted.
AGB_GPU_SBATCH="--partition=h100 --nodes=1 --ntasks=4"
AGB_GPU_TIME="48:00:00"
AGB_GPU_MAX_CONCURRENT=8
AGB_GPUS_PER_TASK=4
AGB_MAX_ARRAY_TASKS=2
# Per-user limit on submitted (pending + running) jobs in the GPU partition, checked by
# submit_region.sh before it submits anything.
AGB_GPU_MAX_SUBMIT=4

# CPU staging on skx (SKX nodes, Max Jobs per User 40, Max Submit 60, 1 SU per
# node-hour, exclusive nodes): one node downloads 5 tiles at once, so tasks x 5 x
# gee_max_requests is checked against the GEE budget.
AGB_CPU_SBATCH="--partition=skx --nodes=1 --ntasks=1"
AGB_CPU_TIME="12:00:00"
AGB_CPU_PAR=5
AGB_MAX_ARRAY_TASKS_CPU=40
AGB_CPU_MAX_SUBMIT=60
AGB_MERGE_SBATCH="--partition=skx --nodes=1 --ntasks=1"
AGB_MERGE_TIME="04:00:00"
AGB_MAX_ARRAY_SIZE=1000
# The Stampede3 user guide: "Do not use the Slurm --export option to manage your job's
# environment" (sbatch options table: "Avoid this option"). submit_region.sh therefore
# sets the job variables in the environment of the sbatch command instead.
AGB_SBATCH_EXPORT="env"

AGB_GPU_MODULES=""
AGB_CPU_MODULES=""
AGB_TORCH_INDEX_URL="https://download.pytorch.org/whl/cu126"
# Storage: $WORK for envs, $SCRATCH for caches and outputs (purged periodically).
