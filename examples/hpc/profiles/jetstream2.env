# shellcheck shell=bash disable=SC2034
# ------------------------------------------------------------------------------
# IU Jetstream2 (OpenStack cloud VMs; no Slurm by default).
# Sources: docs.jetstream-cloud.org/general/instance-flavors/ and
# github.com/jetstream-cloud/js2docs faq/security.md (checked 2026-09-26).
# GPU flavors: g3.medium (25% of an A100, 10 GB), g3.large (50%, 20 GB), g3.xl (A100
# 40 GB); L40S (g4.*) and H100 (g5.*) flavors only on request. Outbound internet is
# allowed by default ("the default security group contains default egress rules"),
# so a VM can stage composites for another system or run small regions end to end.
# Use examples/run_region_delineation.sh --mode local or --mode local-tiles here;
# submit_region.sh refuses this profile.
# ------------------------------------------------------------------------------
AGB_PROFILE_NAME="jetstream2"
AGB_SCHEDULER="none"
AGB_ARCH="x86_64"
AGB_GPU_MODULES=""
AGB_CPU_MODULES=""
AGB_TORCH_INDEX_URL="https://download.pytorch.org/whl/cu126"
